{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cometal portal component families",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "families"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "families": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "route", "description", "members", "aliases", "preview"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
          "name": { "type": "string", "minLength": 1 },
          "route": { "type": "string", "pattern": "^/components/[a-z0-9-/]+/$" },
          "description": { "type": "string", "minLength": 1 },
          "figma": { "type": "string", "pattern": "^https://www\\.figma\\.com/design/KKNGucImxFAtQLBhPy8tLs\\?node-id=[0-9]+-[0-9]+$" },
          "members": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" }
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "kind", "member"],
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
                "kind": { "enum": ["family", "family-child"] },
                "member": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
                "publicExport": { "type": "string", "minLength": 1 }
              }
            }
          },
          "preview": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
