{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cometal Design System sources of truth",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "sources"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "sources": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "ownerRole", "owns", "location", "status"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "name": { "type": "string", "minLength": 1 },
          "ownerRole": { "type": "string", "minLength": 1 },
          "owns": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "location": { "type": "string", "minLength": 1 },
          "status": { "enum": ["connected", "local-only", "pending"] }
        }
      }
    }
  }
}
