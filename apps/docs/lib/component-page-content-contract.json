{
  "schemaVersion": 1,
  "inventory": {
    "sourceRoot": "app/components",
    "primaryNavigationFile": "lib/navigation.ts",
    "tableFamilyNavigationFile": "components/table-family-header.tsx",
    "registryFile": "../../registry/components.json",
    "expectedPrimaryDetailRoutes": 11,
    "expectedTableChildRoutes": 4,
    "expectedTotalDetailRoutes": 15
  },
  "criteria": [
    {
      "id": "identity",
      "label": "Visible identity and stable ID",
      "defaultRequirement": "required"
    },
    {
      "id": "title-summary",
      "label": "Title and purpose summary",
      "defaultRequirement": "required",
      "evidence": {
        "clauses": [
          { "scope": "content", "any": ["<ComponentPageHeader\\b", "<h1(?:\\s|>)"] },
          { "scope": "content", "any": ["\\bsummary=", "<p(?:\\s|>)"] }
        ]
      }
    },
    {
      "id": "lifecycle",
      "label": "Lifecycle Badge",
      "defaultRequirement": "required",
      "evidence": { "clauses": [{ "scope": "content", "all": ["status=", "statusLabel="] }] }
    },
    {
      "id": "figma",
      "label": "Exact Figma source link",
      "defaultRequirement": "required"
    },
    {
      "id": "storybook",
      "label": "Storybook or playground link",
      "defaultRequirement": "required",
      "evidence": { "clauses": [{ "scope": "content", "all": ["playgroundHref=", "storybook"] }] }
    },
    {
      "id": "react-source",
      "label": "React source context and link",
      "defaultRequirement": "required",
      "evidence": {
        "clauses": [
          { "scope": "content", "all": ["sourceHref"] },
          { "scope": "content", "any": ["github\\.com/cometal-design/cometal-design-system/blob/main/packages/react", "component\\.links\\.source", "firstField\\.links\\.source"] }
        ]
      }
    },
    {
      "id": "usage-boundaries",
      "label": "Usage guidance and boundaries",
      "defaultRequirement": "required",
      "evidence": {
        "clauses": [
          { "scope": "content", "any": ["id=\"usage\"", "title=\"Использование\""] },
          { "scope": "content", "any": ["Не используйте", "Для .*используйте", "Product pattern", "границ", "boundary"] }
        ]
      }
    },
    {
      "id": "real-example",
      "label": "Real design-system component example",
      "defaultRequirement": "required"
    },
    {
      "id": "code-example",
      "label": "Install, import, minimal usage and copy",
      "defaultRequirement": "required",
      "evidence": {
        "clauses": [
          { "scope": "content", "all": ["<CodeExample\\b", "usage="] },
          { "scope": "graph", "all": ["Установка", "Импорт", "Пример", "navigator\\.clipboard\\.writeText", "\"install\"\\s*:", "\"import\"\\s*:", "\"example\"\\s*:"] }
        ]
      }
    },
    {
      "id": "matrix",
      "label": "Sizes, variants and states when applicable",
      "defaultRequirement": "conditional",
      "condition": "Required when the component exposes public sizes, variants, values or states.",
      "evidence": {
        "clauses": [{ "scope": "content", "any": ["id=\"sizes\"", "id=\"states\"", "id=\"variants\"", "id=\"values\"", "title=\"[^\"]*матрица", "title=\"Surface и tone\""] }]
      }
    },
    {
      "id": "behavior-a11y",
      "label": "Behavior, keyboard and accessibility",
      "defaultRequirement": "required",
      "evidence": {
        "clauses": [
          { "scope": "content", "any": ["title=\"Поведение\"", "Технический контракт", "нативн[^\n]*семантик", "keyboard", "клавиатур", "tab order", "tab-stop", "доступн"] },
          { "scope": "content", "any": ["keyboard", "клавиатур", "focus", "aria-", "tab order", "tab-stop", "доступн", "нативн[^\n]*семантик"] }
        ]
      }
    },
    {
      "id": "public-api",
      "label": "Public React API reference",
      "defaultRequirement": "required",
      "evidence": { "clauses": [{ "scope": "content", "any": ["id=\"api\"", "title=\"React API\"", "title=\"Общий React API\""] }] }
    },
    {
      "id": "responsive-theme-edge",
      "label": "Responsive, theme and edge-case evidence",
      "defaultRequirement": "required",
      "evidence": {
        "clauses": [
          { "scope": "content", "any": ["responsive", "адаптив", "overflow", "переполн", "320", "768", "1440"] },
          { "scope": "content", "any": ["theme", "тема", "dark", "light"] },
          { "scope": "content", "any": ["edge", "disabled", "error", "empty", "icon-only", "без текста", "длинн", "optional", "отсутствует"] }
        ]
      }
    }
  ],
