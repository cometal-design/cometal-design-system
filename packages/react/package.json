{
  "name": "@cometal/react",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./icons/manifest": {
      "types": "./dist/icons/manifest.d.ts",
      "import": "./dist/icons/manifest.js"
    },
    "./icons/catalog": {
      "types": "./dist/icons/catalog.d.ts",
      "import": "./dist/icons/catalog.js"
    },
    "./icons/*": {
      "types": "./dist/icons/*.d.ts",
      "import": "./dist/icons/*.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "pnpm validate:icons && vite build && node ./scripts/icons/finalize-build.mjs",
    "generate:icons": "node ./scripts/icons/generate-icons.mjs",
    "validate:icons": "node ./scripts/icons/validate-icons.mjs",
    "validate:icons:dist": "node ./scripts/icons/validate-icons.mjs --dist && node ./scripts/icons/validate-bundles.mjs",
    "test": "vitest run --project unit",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "6.0.3",
    "vite": "8.1.5",
    "vite-plugin-dts": "5.0.3",
    "vitest": "4.1.10"
  }
}
